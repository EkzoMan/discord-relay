# --- Secrets: NEVER commit a real .env ---
# Copy this file to `.env` and fill in your values, then `docker compose up -d`.

# Required for relaying messages. Leave empty for UI-only local development.
# https://discord.com/developers/applications -> your app -> Bot -> Reset Token
# IMPORTANT: enable "Message Content Intent" on the same page (privileged intent).
DISCORD_BOT_TOKEN=

# SQLite database with users, sessions and relays (persistent in Docker /data).
RELAY_DB_PATH=/data/relay.db

# Legacy JSON config, kept ONLY for the one-time migration to SQLite: on first
# startup its mappings are imported and owned by the first admin account.
# For bare-metal dev you might prefer: RELAY_CONFIG_PATH=./data/config.json
RELAY_CONFIG_PATH=/data/config.json

# Web server port (uvicorn + docker-compose port mapping).
PORT=8000

# --- Login (session-based, multi-user) ---
# Bootstrap admin credentials. If ADMIN_PASSWORD is set, an admin account is
# created on first start (an existing account's password is never overridden).
#
# *** WARNING ***
# If ADMIN_PASSWORD is left EMPTY and the database has NO users yet, the app
# creates admin/admin — a well-known credential on an internet-scraped port!
# It logs a loud warning and must be changed IMMEDIATELY after the first
# login (Account -> Change password). For any host that is not 127.0.0.1 this
# fallback is effectively "door open": ALWAYS set ADMIN_PASSWORD in .env.
#
# Passwords longer than 1024 characters are rejected everywhere (bounded
# hashing cost); ADMIN_PASSWORD is no exception — an over-long value is
# refused at startup with an error in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session cookie settings.
SESSION_COOKIE_NAME=relay_session
SESSION_TTL_HOURS=168
# Cookie "Secure" attribute: auto = set it when the request arrives over
# HTTPS / X-Forwarded-Proto=https (recommended behind a TLS reverse proxy);
# true = always (e.g. if the proxy does not forward the proto header);
# false = never (LOCAL HTTP DEBUGGING ONLY — cookies then travel unencrypted).
SESSION_COOKIE_SECURE=auto

# Login brute-force throttle (in-memory, per username + client IP).
# Failed attempts allowed inside the window before the lockout, and the
# lockout duration (= counting window) in minutes.
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# DEPRECATED (old optional HTTP Basic auth). Only used as admin bootstrap
# fallback when ADMIN_PASSWORD is empty; set ADMIN_USERNAME/ADMIN_PASSWORD
# instead.
UI_USERNAME=
UI_PASSWORD=

# Set to true to also relay messages sent by bots (default: ignore them).
RELAY_ALLOW_BOT_MESSAGES=false

# Also relay messages posted through webhooks (feed bots like Killtracker
# post via webhook AND are flagged as bots - relaying such source channels
# requires BOTH flags true below). Keep false for human-only channels: it is
# the loop protection for messages this app itself sends via webhook.
# (Default: false - ignore webhook messages.)
RELAY_ALLOW_WEBHOOK_MESSAGES=false

# Python logging level: DEBUG, INFO, WARNING, ERROR.
RELAY_LOG_LEVEL=INFO
